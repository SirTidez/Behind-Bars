<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="build/paths.props" />

    <PropertyGroup>
        <!-- Testing props -->
        <!--<DefineConstants>$(DefineConstants);TestMultiplayer</DefineConstants>-->
        <!-- UnityExplorer is an optional runtime diagnostic mod. Keep it out
             of ordinary builds so debug deployment only contains Behind Bars. -->

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>

        <RootNamespace>Behind_Bars</RootNamespace>

        <Configurations>Debug Mono;Release Mono;Debug IL2CPP;Release IL2CPP</Configurations>
    </PropertyGroup>

    <!-- Paths to other mods that script should add (no guard for mono/il2cpp incompat) -->

    <PropertyGroup Condition="'$(Configuration)' == 'Debug Mono'">
        <DefineConstants>$(DefineConstants);MONO</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release Mono'">
        <DefineConstants>$(DefineConstants);MONO;RELEASE</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug IL2CPP'">
        <DefineConstants>$(DefineConstants)</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release IL2CPP'">
        <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    </PropertyGroup>
    

    <Import Project="build/conditions.props" />

    <ItemGroup Label="Publicizer" Condition="'$(IsMono)' == 'true'">
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.5.0-beta.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- MelonLoader References -->
    <Import Project="build\references\MelonMono.targets" />
    <Import Project="build\references\MelonIL2CPP.targets" />

    <!-- Events -->
    <Import Project="build\events\preBuild.targets" />
    <Import Project="build\events\postBuild.targets" />
    <ItemGroup>
      <!-- Unity authoring projects are deliberately local-only. Keep their
           editor scripts, imported packages, and original source assets out of
           the MelonLoader compile and release surface. -->
      <Compile Remove="Unity\**\*.cs" />
      <Compile Remove="BB Unity Project\**\*.cs" />
      <None Remove="Unity\**" />
      <None Remove="BB Unity Project\**" />
      <Content Remove="Unity\**" />
      <Content Remove="BB Unity Project\**" />
      <EmbeddedResource Remove="Unity\**" />
      <EmbeddedResource Remove="BB Unity Project\**" />
      <None Remove="behind_bars" />
      <None Remove="behind_bars.bundle" />
      <None Remove="behind_bars_scanner_pose" />
      <None Remove="behind_bars_property_locker.bundle" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Include="behind_bars" />
      <EmbeddedResource Include="behind_bars.bundle" />
      <EmbeddedResource Include="behind_bars_scanner_pose" />
      <EmbeddedResource Include="behind_bars_property_locker.bundle" />
      <None Remove="Icons\behindbars.bedroll.png" />
      <EmbeddedResource Include="Icons\behindbars.bedroll.png" />
      <None Remove="Icons\behindbars.cup.png" />
      <EmbeddedResource Include="Icons\behindbars.cup.png" />
      <None Remove="Icons\behindbars.sheetsnpillows.png" />
      <EmbeddedResource Include="Icons\behindbars.sheetsnpillows.png" />
      <None Remove="Icons\behindbars.toothbrush.png" />
      <EmbeddedResource Include="Icons\behindbars.toothbrush.png" />
    </ItemGroup>

</Project>
